# VeriRAG frontend environment configuration
# Copy this file to `.env` and adjust for your environment.
# These are placeholders for FUTURE backend/blockchain integration.
# The current prototype uses mock data only and does NOT call any real service.

# Base URL of the future FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Future smart-contract / network configuration (not used yet)
VITE_CHAIN_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Toggle mock mode. When true, the app uses local mock services only.
VITE_USE_MOCK=true
